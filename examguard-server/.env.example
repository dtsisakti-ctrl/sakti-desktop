# Runtime connection (role WITHOUT table ownership -> RLS is enforced)
EXAMGUARD_DATABASE_URL=postgresql+psycopg://examguard_app:app-password@127.0.0.1:5432/examguard
# Migration connection (schema owner)
EXAMGUARD_MIGRATION_DATABASE_URL=postgresql+psycopg://examguard_owner:owner-password@127.0.0.1:5432/examguard
EXAMGUARD_APP_ROLE=examguard_app
EXAMGUARD_ENV=dev
# Links in emails (verify, reset password, invitations). Default: <EXAMGUARD_PUBLIC_BASE_URL>/portal
# EXAMGUARD_PORTAL_BASE_URL=http://127.0.0.1:8080/portal
EXAMGUARD_STAFF_SESSION_HOURS=12
EXAMGUARD_CANDIDATE_SESSION_HOURS=24
